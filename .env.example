# ============ 必填 ============

# 管理面板登录令牌（自己生成一串随机，例如 openssl rand -hex 32）
ADMIN_TOKEN=change-me-admin-token

# 内置推送令牌（第三方 APP 可直接用它；也可以在面板里另建多把）
API_TOKEN=change-me-push-token

# 中国移动「新消息」ClawBot 的 API Key（ak_...）
# 获取方式见 README「如何拿到 CMCC_API_KEY」
CMCC_API_KEY=ak_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ============ 对外地址 ============

# 浏览器 / 第三方 APP 访问本服务用的地址。
# 没上反代时填 http://服务器IP:18090；反代后填 https://notify.example.com
# GitHub 一键登录的回调地址由它推导，填错会报 redirect_uri_mismatch
BASE_URL=http://127.0.0.1:18090

# ============ 可选：GitHub 一键登录 ============

# 不填则面板只能用 ADMIN_TOKEN 登录
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 允许登录的 GitHub 用户名，逗号分隔，例如 alice,bob；留空 = 禁用 GitHub 登录
GITHUB_ADMIN_LOGINS=

# ============ 可选：移动服务端地址（一般不用改） ============

CMCC_SERVER_URL=wss://5gvas01.cmicmaap.com/gtw-ai/openclaw/ws/msg
CMCC_UPLOAD_URL=https://5gvas01.cmicmaap.com/gtw-ai/openclaw/api
CMCC_VERSION=2.0

# ============ 可选：默认接收人 ============

# 留空即可：用手机给 ClawBot 应用号发一条消息，网关会自动记录接收人
DEFAULT_RECIPIENT=
